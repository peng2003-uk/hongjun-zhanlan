                html += `</div>`;

                // ---- 内容 ----
                if (data.type === 'intro') {
                    html += `<div class="intro-title">${data.title}</div>`;
                    html += `<div class="intro-divider">✦ ✦ ✦</div>`;
                    html += `<div class="intro-text">`;
                    const paras = data.introText.split('\n');
                    paras.forEach(p => { if (p.trim()) html += `<p>${p}</p>`; });
                    html += `</div>`;
                } else if (data.type === 'hero' || data.type === 'epilogue') {
                    if (data.blocks) {
                        html += `<div style="font-size:0.95rem;line-height:2.1;">`;
                        data.blocks.forEach(b => {
                            if (b.type === 'narr') {
                                const lines = b.text.split('\n');
                                lines.forEach(line => {
                                    if (line.trim()) {
                                        if (line.startsWith('策展缘由') || line.startsWith('展览前言')) {
                                            html += `<p><strong style="color:#e6b17e;">${line}</strong></p>`;
                                        } else {
                                            html += `<p>${line}</p>`;
                                        }
                                    }
                                });
                            }
                        });
                        html += `</div>`;
                    }
                    if (data.type === 'epilogue') {
                        html += `<div class="scene-divider">——— ✦ ———</div>`;
                        html +=
                            `<div style="text-align:center;font-family:'Ma Shan Zheng',cursive;font-size:clamp(1.2rem,2.5vw,1.7rem);color:#c4a88a;padding:4px 0;">✦ 赵小二的万里长征已然落幕 ✦</div>`;
                        html +=
                            `<div style="text-align:center;font-style:italic;font-size:0.95rem;color:#a08878;padding:2px 0 12px;line-height:2;">属于我们每个人的新时代长征，才刚刚启程。<br />如何坚守初心、砥砺前行，走好脚下的长征路，<br />这是值得我们用一生去认真作答的人生课题。</div>`;
                        html += `<div class="epilogue-msg">`;
                        html += `<h4>走好新时代长征路</h4>`;
                        html += `<textarea id="messageInput" placeholder="写下您的感想……"></textarea>`;
                        html += `<button id="sendMessage">留下足迹</button>`;
                        html += `<div class="fb" id="feedback"></div>`;
                        html += `</div>`;
                    }
                } else if (data.type === 'narrative') {
                    // ---- 叙事页 ----
                    html += `<div class="narrative" id="narr_${data.id}">`;
                    data.blocks.forEach((b, bi) => {
                        const cls = `narr-block ${bi === 0 ? 'visible' : ''}`;
                        html += `<div class="${cls}" data-order="${bi}">`;
                        if (b.type === 'narr') {
                            if (b.speaker) html += `<span class=”speaker”>${b.speaker}</span>`;
                            html += `<span class=”qm”>”</span>`;
                            if (b.highlight) {
                                const parts = b.text.split(/(?<=[。！？])/);
                                if (parts.length > 1) {
                                    const last = parts.pop();
                                    html += parts.join('');
                                    html += `<span class=”hl”>${last}</span>`;
                                } else {
                                    html += `<span class=”hl”>${b.text}</span>`;
                                }
                            } else {
                                html += b.text;
                            }
                            html += `<span class=”qm end”>”</span>`;
                        } else if (b.type === 'dialogue') {
                            html += `<span class="dialogue"><span class="who">${b.speaker}：</span>${b.text}</span>`;
                        }
                        html += `</div>`;
                    });
                    html += `<span class="continue-hint show" data-target="narr_${data.id}">▼ 点击继续</span>`;
                    html += `</div>`;
                    html += `<div class="scene-divider">——— ✦ ———</div>`;
                    html +=
                        `<div style="text-align:center;font-size:0.8rem;opacity:0.3;letter-spacing:2px;padding:2px 0 4px;">赵小二的讲述 · 点击下方了解历史背景</div>`;
                } else if (data.type === 'archive') {
                    // ---- 档案页 ----
                    html += `<div class="archive-section">`;
                    data.archives.forEach((arch, ai) => {
                        const isSidecard = arch.isSidecard || false;
                        if (ai > 0) html += `<div class="archive-sub">`;

                        if (isSidecard) {
                            html += `<div class="side-card">`;
                            html += `<h4>📖 ${arch.title}</h4>`;
                            html += `<p>${arch.text}</p>`;
                            if (arch.artifacts && arch.artifacts.length) {
                                html += `<div class="artifact-grid">`;
                                arch.artifacts.forEach(a => {
                                    html +=
                                        `<div class="art-item" style="background-image:url('${a.img}');" data-desc="${a.desc}"><div class="label">${a.desc}</div></div>`;
                                });
                                html += `</div>`;
                            }
                            html += `</div>`;
                        } else {
                            html += `<div class="archive-title"><span class="icon">📜</span>${arch.title}</div>`;
                            html += `<div class="archive-text">`;
                            const paras = arch.text.split('\n');
                            paras.forEach(p => { if (p.trim()) html += `<p>${p}</p>`; });
                            html += `</div>`;
                            if (arch.artifacts && arch.artifacts.length) {
                                html += `<div class="artifact-grid">`;
                                arch.artifacts.forEach(a => {
                                    html +=
                                        `<div class="art-item" style="background-image:url('${a.img}');" data-desc="${a.desc}"><div class="label">${a.desc}</div></div>`;
                                });
                                html += `</div>`;
                            }
                        }
                        if (ai > 0) html += `</div>`;
                    });
                    html += `</div>`;
                }

                // ---- 底部引导 ----
                if (data.guide) {
                    html += `<div class="scene-guide">`;
                    const guideText = data.guide.replace(/\n/g, '<br />');
                    html += `<div class="guide-text">${guideText}</div>`;

                    let btnLabel = '继续 →';
                    let btnClass = 'btn-next';
                    let extraHtml = '';

                    if (data.type === 'narrative') {
                        btnLabel = '📜 了解历史背景 →';
                        btnClass = 'btn-next btn-next-narrative';
                    } else if (data.type === 'archive') {
                        btnLabel = '📖 继续赵小二的故事 →';
                        btnClass = 'btn-next';
                        extraHtml =
                            `<span class="transition-hint">历史档案读毕 · 回到赵小二的视角</span>`;
                    } else if (data.type === 'intro') {
                        btnLabel = '🚩 进入单元 →';
                        btnClass = 'btn-next';
                        extraHtml =
                            `<span class="transition-hint">单元导语读毕 · 走进赵小二的故事</span>`;
                    } else if (data.type === 'hero') {
                        btnLabel = '🚩 走进第一单元 →';
                        btnClass = 'btn-next';
                    } else if (data.type === 'epilogue') {
                        btnLabel = '⬆ 回到序厅';
                        btnClass = 'btn-next';
                    }

                    const nextId = data.next;
                    if (nextId && nextId !== data.id && idMap[nextId]) {
                        if (data.type === 'narrative') {
                            html +=
                                `<button id="btn-next-${data.id}" class="${btnClass}" data-next="${nextId}" style="display:none;">${btnLabel} <span class="arrow">→</span></button>`;
                        } else {
                            html += `<div class="btn-with-label">`;
                            if (extraHtml) html += extraHtml;
                            html +=
                                `<button class="${btnClass}" data-next="${nextId}">${btnLabel} <span class="arrow">→</span><span class="pulse-ring-btn"></span></button>`;
                            html += `</div>`;
                        }
                    } else if (data.type === 'epilogue') {
                        html +=
                            `<button class="btn-next" data-next="hero">⬆ 回到序厅 <span class="arrow">→</span></button>`;
                    }
                    html += `</div>`;
                }

                html += `</div>`;
                container.innerHTML = html;

                // ---- 更新顶部 ----
                const unitName = data.unit || '序厅';
                unitIndicator.innerHTML = `<strong>${unitName}</strong>`;

                // ---- 导航按钮 ----
                const prevBtn = document.getElementById('prevBtn');
                const nextBtn = document.getElementById('nextBtn');
                prevBtn.style.opacity = idx > 0 ? '1' : '0.3';
                nextBtn.style.opacity = idx < pageIds.length - 1 ? '1' : '0.3';

                // ---- 路线图 ----
                renderMap(data.nodeIndex || 0);

                // ---- 绑定事件 ----
                bindPageEvents(data.id);

                // ---- 叙事逐段显现（仅叙事页） ----
                if (data.type === 'narrative') {
                    setupNarrative(data.id);
                }

                // ---- 结语留言 ----
                if (data.type === 'epilogue') {
                    setupEpilogue();
                }

                // ---- 文物点击 ----
                document.querySelectorAll('.art-item').forEach(el => {
                    el.addEventListener('click', function() {
                        const bg = this.style.backgroundImage;
                        const desc = this.dataset.desc || '文物展品';
                        const urlMatch = bg.match(/url\(["']?(.*?)["']?\)/);
                        if (urlMatch && urlMatch[1]) {
                            document.getElementById('modalImg').src = urlMatch[1];
                        } else {
                            document.getElementById('modalImg').src = 'https://picsum.photos/seed/default/600/400';
                        }
                        document.getElementById('modalDesc').textContent = desc;
                        document.getElementById('modal').classList.add('active');
                        document.body.style.overflow = 'hidden';
                    });
                });

                content.scrollTop = 0;
            }

            // ================================================================
            // 5. 逐段显现（叙事页专用）
            // ================================================================

            function setupNarrative(pageId) {
                const container = document.getElementById(`narr_${pageId}`);
                if (!container) return;
                const blocks = container.querySelectorAll('.narr-block');
                const hint = container.querySelector('.continue-hint');
                const btn = document.getElementById(`btn-next-${pageId}`);
                if (!blocks.length) return;

                let currentBlock = 1;
                let isComplete = false;

                if (blocks.length <= 1) {
                    isComplete = true;
                    if (btn) {
                        btn.style.display = 'inline-block';
                        btn.classList.add('show');
                    }
                    hint.classList.remove('show');
                    return;
                }

                function showNext() {
                    if (currentBlock < blocks.length) {
                        blocks[currentBlock].classList.add('visible');
                        currentBlock++;
                        if (currentBlock < blocks.length) {
                            hint.classList.add('show');
                        } else {
                            hint.classList.remove('show');
                            isComplete = true;
                            if (btn) {
                                btn.style.display = 'inline-block';
                                btn.classList.add('show');
                            }
                        }
                    } else {
                        hint.classList.remove('show');
                        isComplete = true;
                        if (btn) {
                            btn.style.display = 'inline-block';
                            btn.classList.add('show');
                        }
                    }
                }

                hint.addEventListener('click', showNext);
                container.addEventListener('click', function(e) {
                    if (e.target.closest('.btn-next')) return;
                    if (!isComplete && currentBlock <= blocks.length) {
                        showNext();
                    }
                });

                if (blocks.length > 1) {
                    hint.classList.add('show');
                } else {
                    hint.classList.remove('show');
                }
            }

            // ================================================================
            // 6. 结语留言
            // ================================================================

            function setupEpilogue() {
                const msgInput = document.getElementById('messageInput');
                const sendBtn = document.getElementById('sendMessage');
                const feedback = document.getElementById('feedback');
                if (sendBtn) {
                    sendBtn.addEventListener('click', function() {
                        const msg = msgInput.value.trim();
                        if (msg) {
                            feedback.textContent = '❤️ 感谢您的留言：“' + msg + '” 长征精神永放光芒！';
                            msgInput.value = '';
                            try { localStorage.setItem('red_小鬼留言', msg); } catch (e) {}
                        } else {
                            feedback.textContent = '请写下您的感想再提交。';
                        }
                    });
                }
                try {
                    const saved = localStorage.getItem('red_小鬼留言');
                    if (saved && feedback) feedback.textContent = '❤️ 您曾留言：“' + saved + '”';
                } catch (e) {}
            }

            // ================================================================
            // 7. 页面切换
            // ================================================================

            function goToPage(idx) {
                if (isTransitioning || idx === currentIdx) return;
                if (idx < 0 || idx >= pageIds.length) return;
                isTransitioning = true;
                currentIdx = idx;
                renderPage(idx);
                setTimeout(() => { isTransitioning = false; }, 400);
            }

            function bindPageEvents(pageId) {
                document.querySelectorAll('.btn-next').forEach(btn => {
                    btn.addEventListener('click', function(e) {
                        e.stopPropagation();
                        const target = this.dataset.next;
                        if (target && idMap[target]) {
                            const idx = pageIds.indexOf(target);
                            if (idx !== -1) goToPage(idx);
                        }
                    });
                });
            }

            // ================================================================
            // 8. 导航按钮
            // ================================================================

            document.getElementById('prevBtn').addEventListener('click', function() {
                if (currentIdx > 0) goToPage(currentIdx - 1);
            });
            document.getElementById('nextBtn').addEventListener('click', function() {
                if (currentIdx < pageIds.length - 1) goToPage(currentIdx + 1);
            });

            document.addEventListener('keydown', function(e) {
                if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
                if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
                    e.preventDefault();
                    if (currentIdx < pageIds.length - 1) goToPage(currentIdx + 1);
                } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
                    e.preventDefault();
                    if (currentIdx > 0) goToPage(currentIdx - 1);
                }
            });

            // ================================================================
            // 9. 模态框
            // ================================================================

            document.getElementById('modalClose').addEventListener('click', function() {
                document.getElementById('modal').classList.remove('active');
                document.body.style.overflow = '';
            });
            document.getElementById('modal').addEventListener('click', function(e) {
                if (e.target === this) {
                    this.classList.remove('active');
                    document.body.style.overflow = '';
                }
            });
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    document.getElementById('modal').classList.remove('active');
                    document.body.style.overflow = '';
                }
            });

            // ================================================================
            // 10. 封面进入
            // ================================================================

            document.getElementById('enterBtn').addEventListener('click', function() {
                document.getElementById('cover').classList.remove('active');
                document.getElementById('cover').style.display = 'none';
                document.getElementById('app').classList.add('visible');
                document.body.style.overflow = 'hidden';
                renderPage(0);
            });

            document.body.style.overflow = 'hidden';
            document.getElementById('cover').style.display = 'flex';

            console.log('✦ 红小鬼 · 长征线上展览 最终版 ✦');
            console.log('📄 共 ' + pageIds.length + ' 个页面');
            console.log('🔘 导语页 → 单元 | 档案页 → 叙事，均有明确交互引导');
            console.log('⌨️  键盘 ← → 切换页面');

        })();
    </script>
</body>
</html>