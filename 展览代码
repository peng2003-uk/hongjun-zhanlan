            ];

            function renderMap(activeNodeIdx) {
                // 边界保护
                const safeIdx = Math.min(Math.max(activeNodeIdx, 0), pts.length - 1);

                let svg =
                    `<svg viewBox="0 0 120 520" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;max-height:520px;">`;

                for (let i = 0; i < pts.length - 1; i++) {
                    const done = i < safeIdx;
                    svg += `<line x1="${pts[i].x}" y1="${pts[i].y}" x2="${pts[i+1].x}" y2="${pts[i+1].y}" 
                              class="map-path ${done ? 'done' : ''}" />`;
                }

                pts.forEach((p, i) => {
                    const isActive = (i === safeIdx);
                    const isVisited = (i < safeIdx);
                    const label = nodeLabels[i] || '';
                    svg += `<g class="map-node ${isActive ? 'active' : ''} ${isVisited ? 'visited' : ''}" data-node="${i}" style="cursor:pointer;">`;
                    svg += `<circle cx="${p.x}" cy="${p.y}" r="${isActive ? 7 : 5}" />`;
                    svg +=
                        `<text x="${p.x}" y="${p.y + (i % 2 === 0 ? -14 : 16)}" font-size="6" fill="#6a5a4a" text-anchor="middle" dominant-baseline="central">${label}</text>`;
                    svg += `</g>`;
                });

                svg += `</svg>`;
                document.getElementById('mapSvgWrap').innerHTML = svg;

                document.querySelectorAll('.map-node').forEach(el => {
                    el.addEventListener('click', function() {
                        const nodeIdx = parseInt(this.dataset.node);
                        let targetId = null;
                        for (const p of pages) {
