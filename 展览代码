            // ================================================================
            // 2. 构建页面列表（叙事页 + 档案页分离）
            // ================================================================

            function buildPages(rawScenes) {
                const pages = [];
                const idMap = {};

                rawScenes.forEach((raw, idx) => {
                    const isSceneWithArchives = raw.type === 'scene' && raw.archives && raw.archives.length > 0;

                    if (isSceneWithArchives) {
                        // ---- 叙事页 ----
                        const narrId = raw.id + '_narr';
                        const archId = raw.id + '_arch';
                        const narrPage = {
                            id: narrId,
                            type: 'narrative',
                            unit: raw.unit,
                            title: raw.title,
                            number: raw.number,
                            bg: raw.bg,
                            nodeIndex: raw.nodeIndex,
                            blocks: raw.blocks,
                            guide: raw.guide,
                            next: archId,
                            rawId: raw.id
                        };
                        pages.push(narrPage);
                        idMap[narrId] = narrPage;

                        // ---- 档案页 ----
                        const archPage = {
                            id: archId,
                            type: 'archive',
                            unit: raw.unit,
                            title: raw.title,
                            number: raw.number,
                            bg: raw.bg,
                            nodeIndex: raw.nodeIndex,
                            archives: raw.archives,
                            guide: raw.guide,
                            next: raw.nextRaw || null,
                            rawId: raw.id
                        };
                        pages.push(archPage);
                        idMap[archId] = archPage;

                        raw._narrId = narrId;
                        raw._archId = archId;
                    } else {
                        // ---- 非场景（intro, hero, epilogue）直接作为页面 ----
                        const page = {
                            id: raw.id,
                            type: raw.type,
                            unit: raw.unit,
                            title: raw.title,
                            bg: raw.bg,
                            nodeIndex: raw.nodeIndex || 0,
                            guide: raw.guide,
                            next: raw.nextRaw || null,
                            rawId: raw.id
                        };
                        if (raw.type === 'intro') {
                            page.introText = raw.introText;
                        } else if (raw.type === 'hero' || raw.type === 'epilogue') {
                            page.blocks = raw.blocks;
                        }
                        pages.push(page);
                        idMap[raw.id] = page;
                        raw._pageId = raw.id;
                    }
                });

                // 修正 next 引用
                pages.forEach(p => {
                    if (p.next && p.next.startsWith('unit') && !p.next.includes('_')) {
                        const raw = rawScenes.find(r => r.id === p.next);
                        if (raw) {
                            if (raw.type === 'scene' && raw.archives && raw.archives.length > 0) {
                                p.next = raw.id + '_narr';
                            } else {
                                p.next = raw.id;
                            }
                        }
                    }
                    if (!p.next) {
                        p.next = p.id;
                    }
                });

                return { pages, idMap };
            }

            const { pages, idMap } = buildPages(rawScenes);
