    <script>
        (function() {
            'use strict';

            // ================================================================
            // 1. 原始场景数据
            // ================================================================

            const rawScenes = [{
                id: 'hero',
                type: 'hero',
                unit: '序厅',
                title: '雄关漫道真如铁',
                subtitle: '一个"红小鬼"的长征路',
                bg: 'scene-bg-hero',
                nodeIndex: 0,
                blocks: [
                    { type: 'narr', text: '策展缘由\n"为有牺牲多壮志，敢教日月换新天"。长征是人类历史上的伟大奇迹。今年是中国红军长征胜利90周年，为了纪念红军长征并让观众了解长征路上的艰苦岁月，感悟先辈们的牺牲和奉献，特此推出长征文化展。' },
                    { type: 'narr',
                        text: '展览前言\n1934年10月，中共中央和中革军委率中央红军主力从江西于都出发，开始战略转移。至1936年10月三大主力会师，历时两年，途经十余省，翻越雪山，穿过草地，进行重要战役战斗六百余次，总行程约二万五千里。史称长征。' },
                    { type: 'narr',
                        text: '长征队伍中包含一定数量的少年战士，年龄多在8至16岁之间，通常被称为"红小鬼"。据不完全统计，仅中央红军中就有约一万余名。本展览以虚构人物"赵小二"为叙述者，其经历综合自长征亲历者的口述史、回忆录及档案记载，是红小鬼群体共同记忆的凝结。' }
                ],
                guide: '一个十三岁的孤儿，死缠烂打加入了红军。他还不懂什么是革命，只知道——红军给了他一个家。',
                nextRaw: 'unit1_intro'
            }, {
                id: 'unit1_intro',
                type: 'intro',
                unit: '第一单元',
                title: '倔强 · 初入红军',
                bg: 'scene-bg-1',
                nodeIndex: 0,
                introText: '1933年9月，国民党调集重兵对中央苏区发动第五次大规模"围剿"，依靠碉堡封锁与经济围困，逐步压缩根据地范围。受"左"倾错误军事指挥影响，中央红军放弃灵活战术，与强敌开展阵地消耗战，苦战一年后反"围剿"最终失利。\n1934年上半年，中央苏区多处重要防线失守，内外形势日趋严峻。为保存革命有生力量，中共中央决定实施战略转移，并选定地理与敌情条件相对有利的江西于都作为集结出发地。1934年10月，八万余名中央红军主力将士齐聚于都，筹备撤离中央苏区，举世闻名的长征由此启程。\n当大部队要从瑞金转移到于都、准备离开根据地时，十三岁的孤儿赵小二不愿再重回流浪生活，几番坚持后如愿加入红军，被分配为小号手学徒。这名倔强的红小鬼，从此与数万红军战士一道，走进了艰苦卓绝的烽火征程。',
                guide: '一个孤儿，一把军号，一段改变命运的征途。',
                nextRaw: 'unit1_1'
            }, {
                id: 'unit1_1',
                type: 'scene',
                unit: '第一单元 · 倔强',
                title: '我叫赵小二',
                number: '场景 1 / 3',
                bg: 'scene-bg-1',
                nodeIndex: 0,
                blocks: [
                    { type: 'narr', speaker: '赵小二',
                        text: '我叫赵小二，生长在赣南的乡村。黑暗的年月里，苦难早早找上了我。父亲参加农会投身革命，被国民党靖卫团残忍杀害；母亲积劳成疾，没钱医治，最终也撒手离去。短短时间，我成了无依无靠的孤儿。' },
                    { type: 'narr',
                        text: '往后的日子，我只能靠放牛、沿街乞讨谋生，常年食不果腹、颠沛流离。直到红军进驻苏区，废除了压在百姓身上的苛捐杂税，穷苦人终于有了活路。在这里，我第一次吃上热腾腾的饱饭，不再看人脸色过日子。' },
                    { type: 'narr', text: '那时的我年纪尚小，听不懂高深的革命道理，心里只有最简单的想法：红军收留了我，给了我温暖和温饱，这里就是我的家。',
                        highlight: true }
                ],
                archives: [{
                    title: '历史档案：长征前夕的赣南苏区',
                    text: '土地革命战争时期，赣南是中央革命根据地的核心区域。国民党当局对苏区轮番开展军事"围剿"，实行全方位经济封锁，同时大肆征收苛捐杂税，当地底层民众在战乱与盘剥中艰难度日。\n红军抵达赣南并建立苏维埃政权后，大力开展土地革命，将土地分给贫苦农民，彻底废除各类苛捐杂税。苏区政府设立专门机构与群众团体，对孤寡、流浪孤儿等困难群体开展常态化救助。',
                    artifacts: [
                        { img: 'https://picsum.photos/seed/soviet1/200/150', desc: '苏区户籍门牌' },
