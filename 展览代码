<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
    <title>雄关漫道真如铁 · 红小鬼的长征路</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Ma+Shan+Zheng&family=Noto+Serif+SC:wght@400;600;700&display=swap" rel="stylesheet" />
    <style>
        /* ===== 全局 ===== */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        :root {
            --red: #8B1A1A;
            --red-light: #B22222;
            --gold: #C4A88A;
            --gold-light: #E6C9A8;
            --paper: #F5E6C8;
            --paper-dark: #E8DCCC;
            --ink: #1A1A1A;
            --ink-light: #3D2B1F;
            --bg-dark: #1E1A16;
            --shadow: 0 12px 40px rgba(0, 0, 0, 0.15);
            --radius: 24px;
            --transition: 0.5s cubic-bezier(0.23, 1, 0.32, 1);
            --font-title: 'Ma Shan Zheng', '华文行楷', cursive;
            --font-serif: 'Noto Serif SC', '宋体', serif;
        }
        html {
            scroll-behavior: smooth;
        }
        body {
            font-family: var(--font-serif);
            background: var(--bg-dark);
            color: var(--ink);
            overflow: hidden;
            height: 100vh;
            width: 100vw;
        }
        ::-webkit-scrollbar {
            width: 4px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.02);
        }
        ::-webkit-scrollbar-thumb {
            background: var(--red-light);
            border-radius: 4px;
        }

        /* ===== 封面 ===== */
        #cover {
            position: fixed;
            inset: 0;
            z-index: 3000;
            display: none;
            align-items: center;
            justify-content: center;
            background: radial-gradient(ellipse at 30% 20%, #2a1212, #0d0808);
            flex-direction: column;
            overflow: hidden;
        }
        #cover.active {
            display: flex;
        }
        #cover .bg-deco {
            position: absolute;
            inset: 0;
            pointer-events: none;
            overflow: hidden;
        }
        #cover .bg-deco .stars {
            position: absolute;
            inset: 0;
            background-image:
                radial-gradient(2px 2px at 20% 30%, rgba(255, 215, 150, 0.3), transparent),
                radial-gradient(2px 2px at 40% 70%, rgba(255, 215, 150, 0.2), transparent),
                radial-gradient(1px 1px at 60% 20%, rgba(255, 215, 150, 0.4), transparent),
                radial-gradient(1px 1px at 80% 50%, rgba(255, 215, 150, 0.2), transparent),
                radial-gradient(2px 2px at 10% 80%, rgba(255, 215, 150, 0.25), transparent),
                radial-gradient(1px 1px at 90% 10%, rgba(255, 215, 150, 0.3), transparent);
            background-size: 200% 200%;
            animation: twinkle 8s ease-in-out infinite alternate;
        }
        @keyframes twinkle {
            0% {
                opacity: 0.5;
            }
            100% {
                opacity: 1;
            }
        }
        #cover .bg-deco .mountain {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 40%;
            background: linear-gradient(180deg, transparent 0%, rgba(40, 20, 20, 0.3) 40%, rgba(20, 10, 10, 0.6) 100%);
            clip-path: polygon(0% 60%, 15% 30%, 30% 55%, 45% 20%, 60% 45%, 75% 25%, 85% 50%, 100% 35%, 100% 100%, 0% 100%);
        }
        #cover .poster {
            position: relative;
            z-index: 2;
            max-width: 680px;
            width: 100%;
            padding: 40px 32px 36px;
            background: linear-gradient(145deg, rgba(30, 20, 16, 0.88), rgba(20, 14, 12, 0.94));
            backdrop-filter: blur(18px);
            border-radius: 32px;
            border: 1px solid rgba(178, 34, 34, 0.3);
            box-shadow: 0 40px 80px rgba(0, 0, 0, 0.8), inset 0 1px 0 rgba(255, 215, 150, 0.05);
            text-align: center;
            margin: 20px;
            animation: floatPoster 4s ease-in-out infinite;
        }
        @keyframes floatPoster {
            0%,
            100% {
                transform: translateY(0);
            }
            50% {
                transform: translateY(-8px);
            }
        }
        #cover .poster .star {
            font-size: 2.6rem;
            color: var(--red-light);
            text-shadow: 0 0 40px rgba(178, 34, 34, 0.3);
            display: block;
            margin-bottom: 2px;
        }
        #cover .poster .year {
            font-size: 0.75rem;
            color: #8a6a5a;
            letter-spacing: 6px;
            margin-bottom: 10px;
            font-weight: 300;
        }
        #cover .poster .main-title {
            font-family: var(--font-title);
            font-size: clamp(2.2rem, 6.5vw, 4.2rem);
            color: var(--gold-light);
            letter-spacing: 8px;
            text-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);
            line-height: 1.2;
        }
        #cover .poster .main-title .red {
            color: var(--red-light);
        }
        #cover .poster .sub-title {
            font-size: clamp(0.85rem, 1.6vw, 1.2rem);
            color: var(--gold);
            letter-spacing: 6px;
            margin: 6px 0 12px;
            font-weight: 300;
        }
        #cover .poster .divider-line {
            width: 80px;
            height: 2px;
            margin: 12px auto 16px;
            background: linear-gradient(90deg, transparent, var(--red-light), transparent);
            border-radius: 4px;
        }
        #cover .poster .desc {
            font-size: 0.82rem;
            color: #8a7a6a;
            letter-spacing: 2px;
            line-height: 1.8;
            max-width: 400px;
            margin: 0 auto 22px;
            font-weight: 300;
        }
        #cover .poster .btn-enter {
            background: var(--red-light);
            border: none;
            color: #fff;
            font-family: inherit;
            font-size: 0.95rem;
            padding: 14px 44px;
            border-radius: 60px;
            cursor: pointer;
            transition: var(--transition);
            box-shadow: 0 8px 32px rgba(178, 34, 34, 0.35);
            letter-spacing: 3px;
            font-weight: 600;
            position: relative;
            overflow: hidden;
        }
        #cover .poster .btn-enter:hover {
            background: var(--red);
            transform: scale(1.04);
            box-shadow: 0 12px 48px rgba(178, 34, 34, 0.5);
        }
        #cover .poster .btn-enter .arrow {
            display: inline-block;
            margin-left: 8px;
            transition: var(--transition);
        }
        #cover .poster .btn-enter:hover .arrow {
            transform: translateX(8px);
        }
        #cover .poster .btn-enter .pulse-ring {
            position: absolute;
            inset: -4px;
            border-radius: 64px;
            border: 2px solid rgba(178, 34, 34, 0.2);
            animation: pulseRing 2.4s ease-out infinite;
        }
        @keyframes pulseRing {
            0% {
                transform: scale(1);
                opacity: 1;
            }
            100% {
                transform: scale(1.12);
                opacity: 0;
            }
        }
        #cover .poster .footer-note {
            margin-top: 18px;
            font-size: 0.6rem;
            color: #5a4a3a;
            letter-spacing: 3px;
        }
        #cover .poster .footer-note strong {
            color: #7a5a4a;
        }

        /* ===== 主布局 ===== */
        #app {
            display: none;
            height: 100vh;
            width: 100vw;
            overflow: hidden;
            background: var(--paper);
        }
        #app.visible {
            display: flex;
        }

        /* ===== 左侧路线图 ===== */
        #mapNav {
            width: 160px;
            min-width: 160px;
            height: 100vh;
            background: linear-gradient(180deg, #1a1410 0%, #1e1a16 100%);
            padding: 60px 0 30px 0;
            overflow-y: auto;
            overflow-x: hidden;
            border-right: 1px solid rgba(178, 34, 34, 0.15);
            flex-shrink: 0;
            z-index: 100;
        }
        #mapNav::-webkit-scrollbar {
            width: 2px;
        }
        #mapNav::-webkit-scrollbar-thumb {
            background: var(--red-light);
            border-radius: 2px;
        }
        #mapNav .map-title {
            text-align: center;
            color: var(--gold-light);
            font-family: var(--font-title);
            font-size: 0.9rem;
            letter-spacing: 4px;
            padding: 0 10px 16px;
            border-bottom: 1px solid rgba(178, 34, 34, 0.15);
            margin: 0 12px 16px;
        }
        #mapNav .map-title span {
            display: block;
            font-size: 0.55rem;
            font-family: var(--font-serif);
            color: #6a5a4a;
            letter-spacing: 3px;
            font-weight: 300;
            margin-top: 2px;
        }
        #mapNav .map-svg-wrap {
            padding: 0 12px;
            display: flex;
            justify-content: center;
        }
        #mapNav .map-svg-wrap svg {
            width: 100%;
            height: auto;
            max-height: calc(100vh - 160px);
        }
        .map-node {
            cursor: pointer;
            transition: all 0.3s;
        }
        .map-node circle {
            transition: all 0.3s;
            fill: #3a2a1a;
            stroke: #5a4a3a;
            stroke-width: 2;
        }
        .map-node text {
            fill: #6a5a4a;
            font-size: 7px;
            font-family: var(--font-serif);
            letter-spacing: 0.5px;
            dominant-baseline: central;
            text-anchor: middle;
            pointer-events: none;
            transition: all 0.3s;
        }
        .map-node .node-label {
            fill: #6a5a4a;
            font-size: 5.5px;
            font-family: var(--font-serif);
            letter-spacing: 0.3px;
            dominant-baseline: hanging;
            text-anchor: middle;
            pointer-events: none;
            transition: all 0.3s;
        }
        .map-node:hover circle {
            fill: #5a3a2a;
            stroke: var(--gold);
            stroke-width: 2.5;
            r: 6;
        }
        .map-node:hover text,
        .map-node:hover .node-label {
            fill: var(--gold-light);
        }
        .map-node.active circle {
            fill: var(--red-light);
            stroke: var(--gold);
            stroke-width: 3;
            r: 7;
            filter: drop-shadow(0 0 12px rgba(178, 34, 34, 0.5));
        }
        .map-node.active text,
        .map-node.active .node-label {
            fill: var(--gold-light);
        }
        .map-node.visited circle {
            fill: #5a3a2a;
            stroke: #7a5a3a;
        }
        .map-node.visited text,
        .map-node.visited .node-label {
            fill: #8a7a6a;
        }
        .map-path {
            stroke: #3a2a1a;
            stroke-width: 2;
            fill: none;
            stroke-dasharray: 4 4;
        }
        .map-path.done {
            stroke: var(--red-light);
            stroke-dasharray: none;
            opacity: 0.6;
        }

        /* ===== 右侧内容区 ===== */
        #content {
            flex: 1;
            height: 100vh;
            overflow-y: auto;
            overflow-x: hidden;
            background: var(--paper);
            padding: 0;
            position: relative;
            scroll-behavior: smooth;
        }
        #content::-webkit-scrollbar {
            width: 4px;
        }
        #content::-webkit-scrollbar-thumb {
            background: var(--red-light);
            border-radius: 4px;
        }

        /* ===== 顶部栏 ===== */
        #topBar {
            position: sticky;
            top: 0;
            z-index: 50;
            background: rgba(245, 230, 200, 0.92);
            backdrop-filter: blur(12px);
            padding: 8px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid rgba(139, 26, 26, 0.08);
            min-height: 48px;
        }
        #topBar .brand {
            font-family: var(--font-title);
            font-size: 1rem;
            color: var(--ink);
            letter-spacing: 3px;
        }
        #topBar .brand .red {
            color: var(--red-light);
        }
        #topBar .unit-indicator {
            font-size: 0.75rem;
            color: var(--ink-light);
            opacity: 0.6;
            letter-spacing: 1px;
        }
        #topBar .unit-indicator strong {
            color: var(--red-light);
            opacity: 1;
            font-weight: 600;
        }
        #topBar .nav-controls {
            display: flex;
            gap: 8px;
        }
        #topBar .nav-controls button {
            background: transparent;
            border: 1px solid rgba(139, 26, 26, 0.15);
            color: var(--ink-light);
            width: 32px;
            height: 32px;
            border-radius: 50%;
            cursor: pointer;
            transition: var(--transition);
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: var(--font-serif);
        }
        #topBar .nav-controls button:hover {
            background: var(--red-light);
            color: #fff;
            border-color: var(--red-light);
        }

        /* ===== 场景容器 ===== */
        #sceneContainer {
            padding: 0 24px 60px;
            max-width: 860px;
            margin: 0 auto;
        }

        /* ===== 场景卡片 ===== */
        .scene-card {
            background: rgba(255, 248, 235, 0.85);
            backdrop-filter: blur(8px);
            border-radius: var(--radius);
            padding: 32px 36px 40px;
            box-shadow: var(--shadow);
            border: 1px solid rgba(255, 255, 255, 0.06);
            margin: 20px 0 30px;
            animation: fadeIn 0.6s ease forwards;
            position: relative;
        }
        @keyframes fadeIn {
            0% {
                opacity: 0;
                transform: translateY(20px);
            }
            100% {
                opacity: 1;
                transform: translateY(0);
            }
        }
        .scene-bg-hero .scene-card {
            background: rgba(30, 24, 20, 0.88);
            color: var(--gold-light);
            border-color: rgba(178, 34, 34, 0.1);
        }
        .scene-bg-1 .scene-card {
            background: rgba(255, 248, 235, 0.88);
        }
        .scene-bg-2 .scene-card {
            background: rgba(40, 30, 25, 0.88);
            color: #f0e0d0;
            border-color: rgba(178, 34, 34, 0.12);
        }
        .scene-bg-3 .scene-card {
            background: rgba(248, 240, 230, 0.88);
        }
        .scene-bg-4 .scene-card {
            background: rgba(35, 45, 30, 0.88);
            color: #e8e0d0;
            border-color: rgba(178, 34, 34, 0.1);
        }
        .scene-bg-5 .scene-card {
            background: rgba(210, 180, 140, 0.88);
        }
        .scene-bg-epilogue .scene-card {
            background: rgba(30, 26, 22, 0.90);
            color: #e8ddd0;
            border-color: rgba(178, 34, 34, 0.08);
        }

        /* ===== 场景头部 ===== */
        .scene-header {
            text-align: center;
            margin-bottom: 18px;
        }
        .scene-header .unit-tag {
            font-size: 0.6rem;
            letter-spacing: 4px;
            opacity: 0.35;
            font-weight: 300;
        }
        .scene-header .scene-number {
            font-size: 0.65rem;
            opacity: 0.25;
            letter-spacing: 2px;
            display: block;
            margin-top: 2px;
        }
        .scene-header .page-type-tag {
            display: inline-block;
            font-size: 0.55rem;
            letter-spacing: 2px;
            padding: 2px 14px;
            border-radius: 20px;
            background: rgba(178, 34, 34, 0.08);
            color: var(--red-light);
            margin-top: 4px;
            font-weight: 400;
        }
        .scene-bg-2 .scene-header .page-type-tag {
            background: rgba(196, 168, 138, 0.15);
            color: var(--gold);
        }
        .scene-bg-4 .scene-header .page-type-tag {
            background: rgba(196, 168, 138, 0.12);
            color: var(--gold);
        }
        .scene-header h3 {
            font-family: var(--font-title);
            font-size: clamp(1.4rem, 2.8vw, 2rem);
            letter-spacing: 4px;
            margin: 4px 0 2px;
        }
        .scene-bg-2 .scene-header h3 {
            color: var(--gold);
        }
        .scene-bg-4 .scene-header h3 {
            color: var(--gold);
        }
        .scene-bg-hero .scene-header h3 {
            color: var(--gold-light);
        }
        .scene-bg-epilogue .scene-header h3 {
            color: var(--red-light);
        }

        /* ===== 导语页 ===== */
        .intro-title {
            font-family: var(--font-title);
            font-size: clamp(1.8rem, 3.5vw, 2.6rem);
            text-align: center;
            letter-spacing: 6px;
            margin: 4px 0 12px;
            line-height: 1.3;
        }
        .scene-bg-2 .intro-title {
            color: var(--gold);
        }
        .scene-bg-4 .intro-title {
            color: var(--gold);
        }
        .intro-divider {
            text-align: center;
            padding: 8px 0 14px;
            opacity: 0.15;
            letter-spacing: 8px;
            font-size: 0.7rem;
        }
        .intro-text {
            font-size: 0.98rem;
            line-height: 2.1;
            text-align: justify;
        }
        .intro-text p {
            margin-bottom: 8px;
        }

        /* ===== 叙事区 ===== */
        .narrative {
            font-size: 1rem;
            line-height: 2.2;
            margin-bottom: 4px;
        }
        .narrative .narr-block {
            opacity: 0;
            transform: translateY(12px);
            transition: opacity 0.6s ease, transform 0.6s ease;
            margin-bottom: 8px;
        }
        .narrative .narr-block.visible {
            opacity: 1;
            transform: translateY(0);
        }
        .narrative .narr-block .speaker {
            font-weight: 700;
            color: var(--red);
            display: block;
            font-size: 1rem;
            margin-bottom: 2px;
        }
        .scene-bg-2 .narrative .narr-block .speaker,
        .scene-bg-4 .narrative .narr-block .speaker {
            color: var(--gold);
        }
        .narrative .narr-block .qm {
            color: var(--red-light);
            font-size: 2rem;
            font-family: serif;
            opacity: 0.2;
            line-height: 0.6;
            display: inline-block;
            vertical-align: text-top;
        }
        .narrative .narr-block .qm.end {
            vertical-align: text-bottom;
            margin-left: 2px;
        }
        .narrative .narr-block .hl {
            font-weight: 700;
            color: var(--red-light);
        }
        .scene-bg-2 .narrative .narr-block .hl,
        .scene-bg-4 .narrative .narr-block .hl {
            color: var(--gold);
        }

        /* ===== 对话 ===== */
        .dialogue {
            display: block;
            padding: 6px 16px 6px 20px;
            margin: 6px 0 8px 8px;
            border-left: 4px solid var(--red-light);
            background: rgba(178, 34, 34, 0.05);
            border-radius: 0 8px 8px 0;
            font-style: italic;
            color: #5a2a1a;
        }
        .scene-bg-2 .dialogue,
        .scene-bg-4 .dialogue {
            border-left-color: var(--gold);
            background: rgba(196, 168, 138, 0.08);
            color: #f0e0d0;
        }
        .dialogue .who {
            font-weight: 700;
            color: var(--red);
            font-style: normal;
        }
        .scene-bg-2 .dialogue .who,
        .scene-bg-4 .dialogue .who {
            color: var(--gold);
        }

        /* ===== 继续提示 ===== */
        .continue-hint {
            display: inline-block;
            margin-top: 2px;
            font-size: 0.7rem;
            color: #888;
            opacity: 0;
            transition: opacity 0.5s;
            cursor: pointer;
            letter-spacing: 2px;
        }
        .continue-hint.show {
            opacity: 0.4;
        }
        .continue-hint:hover {
            opacity: 1 !important;
        }
        .scene-bg-2 .continue-hint,
        .scene-bg-4 .continue-hint {
            color: #a08878;
        }

        /* ===== 分隔 ===== */
        .scene-divider {
            text-align: center;
            padding: 14px 0 10px;
            opacity: 0.2;
            letter-spacing: 6px;
            font-size: 0.7rem;
            color: var(--red);
        }
        .scene-bg-2 .scene-divider,
        .scene-bg-4 .scene-divider {
            color: var(--gold);
        }

        /* ===== 档案区 ===== */
        .archive-section {
            margin-top: 4px;
            padding-top: 10px;
        }
        .archive-section .archive-title {
            font-weight: 700;
            color: #5a1a1a;
            font-size: 0.95rem;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .scene-bg-2 .archive-section .archive-title,
        .scene-bg-4 .archive-section .archive-title {
            color: var(--gold);
        }
        .archive-section .archive-title .icon {
            font-size: 1rem;
        }
        .archive-section .archive-text {
            font-size: 0.92rem;
            line-height: 1.9;
            opacity: 0.92;
        }
        .archive-section .archive-text p {
            margin-bottom: 6px;
        }
        .archive-section .archive-sub {
            margin-top: 14px;
            padding-top: 14px;
            border-top: 1px dashed rgba(0, 0, 0, 0.06);
        }
        .scene-bg-2 .archive-section .archive-sub,
        .scene-bg-4 .archive-section .archive-sub {
            border-top-color: rgba(255, 255, 255, 0.06);
        }
        .archive-section .archive-sub .sub-title {
            font-weight: 700;
            color: #5a1a1a;
            font-size: 0.88rem;
            margin-bottom: 4px;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .scene-bg-2 .archive-section .archive-sub .sub-title,
        .scene-bg-4 .archive-section .archive-sub .sub-title {
            color: var(--gold);
        }

        /* ===== 文物图片 ===== */
        .artifact-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 12px;
        }
        .artifact-grid .art-item {
            flex: 1 0 calc(33.33% - 7px);
            min-width: 70px;
            max-width: 150px;
            height: 90px;
            background: #aaa;
            border-radius: 12px;
            overflow: hidden;
            cursor: pointer;
            background-size: cover;
            background-position: center;
            border: 2px solid transparent;
            transition: var(--transition);
            position: relative;
        }
        .artifact-grid .art-item:hover {
            border-color: var(--red-light);
            transform: scale(1.04);
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
        }
        .artifact-grid .art-item .label {
            position: absolute;
            bottom: 0;
